# Supabase Dashboard → your project → Connect
# Use a publishable key (or legacy anon key), never a secret/service_role key.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-only Vercel variables for the resume PDF proxy. Never prefix these with VITE_.
COMPILER_URL=https://YOUR_CLOUD_RUN_SERVICE_URL
COMPILER_SIGNING_SECRET=GENERATE_A_LONG_RANDOM_SECRET
